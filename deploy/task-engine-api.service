[Unit]
Description=Task Engine API (FastAPI + Gunicorn)
After=network.target redis.service
Wants=redis.service

[Service]
User=taskengine
Group=taskengine
WorkingDirectory=/opt/task_engine
EnvironmentFile=/etc/task_engine.env

ExecStart=/opt/task_engine/.venv/bin/gunicorn \
    api.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 4 \
    --bind 127.0.0.1:8000 \
    --access-logfile /var/log/task_engine/api_access.log \
    --error-logfile  /var/log/task_engine/api_error.log \
    --log-level info \
    --timeout 120

ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
